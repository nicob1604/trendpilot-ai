    {
      "parameters": {
        "jsCode": "const newTrends = $('Trend-Daten normalisieren').all();\nconst existingRows = $input.all();\n\nconst existingIds = new Set(\n  existingRows\n    .map((item) => String(item.json.id || '').trim())\n    .filter(Boolean)\n);\n\nconst filteredTrends = newTrends.filter((item) => {\n  const id = String(item.json.id || '').trim();\n  return id && !existingIds.has(id);\n});\n\nreturn filteredTrends;"
      },
